# Copy this file to secrets.yaml and fill in your values.
# (secrets.yaml is git-ignored so you don't publish your Wi-Fi / keys.)

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant API encryption key.
# Generate one in ESPHome (New Device wizard) or run:  openssl rand -base64 32
api_key: "PASTE_A_BASE64_32BYTE_KEY_HERE"
